{
  "name": "@cocreate/loadtest",
  "version": "1.3.0",
  "description": "Dependency-free Node.js load generator for CoCreate Server clusters, HTTP/HTTPS endpoints, and CoCreate socket envelopes.",
  "type": "module",
  "keywords": [
    "cocreate-server",
    "loadtest",
    "load-testing",
    "loadtest",
    "performance-testing",
    "benchmark",
    "cluster",
    "autoscaling",
    "http",
    "https",
    "websocket"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "setup": "node src/setup.js",
    "load": "node src/runner.js",
    "load:http": "LOAD_MODE=http-get node src/runner.js",
    "load:post": "LOAD_MODE=http-post node src/runner.js",
    "load:envelope": "LOAD_MODE=envelope node src/runner.js",
    "load:version": "node --version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/loadtest.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/loadtest/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/loadtest",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreateJS"
  },
  "engines": {
    "node": ">=22.4"
  }
}

{
  "name": "@cocreate/server-loadtest",
  "version": "1.3.0",
  "description": "Dependency-free Node.js load generator for CoCreate Server clusters, HTTP/HTTPS endpoints, and CoCreate socket envelopes.",
  "type": "module",
  "keywords": [
    "cocreate-server",
    "server-loadtest",
    "load-testing",
    "loadtest",
    "performance-testing",
    "benchmark",
    "cluster",
    "autoscaling",
    "http",
    "https",
    "websocket"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "cocreate": {
    "environment": ["tooling"],
    "interface": {
      "schemaVersion": 1,
      "summary": "Dependency-free Node.js load generator for CoCreate Server clusters, socket envelopes, and HTTP endpoints.",
      "status": "Run from a separate load-generator node to measure HTTP, HTTPS, and CoCreate socket workloads.",
      "api": {
        "exports": []
      }
    }
  },
  "scripts": {
    "setup": "node src/setup.js",
    "load": "node src/runner.js",
    "load:http": "LOAD_MODE=http-get node src/runner.js",
    "load:post": "LOAD_MODE=http-post node src/runner.js",
    "load:envelope": "LOAD_MODE=envelope node src/runner.js",
    "load:version": "node --version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/CoCreate-server-loadtest.git"
  },
  "author": "CoCreate LLC",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/CoCreateJS/CoCreate-server-loadtest/issues"
  },
  "homepage": "https://cocreate.app/docs/server-loadtest",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "engines": {
    "node": ">=22.4"
  }
}
